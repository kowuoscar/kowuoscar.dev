---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  class="brutal-shadow-sm border-2 border-ink bg-card px-2.5 py-1 font-mono text-[13px] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
>
  <span class="dark:hidden" aria-hidden="true">☾</span>
  <span class="hidden dark:inline" aria-hidden="true">☀</span>
</button>

<script>
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    sync();
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice just won't persist */
      }
      sync();
    });
  }
</script>
