---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../i18n/ui';
import { education, experience } from '../data/profile';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<BaseLayout locale={locale} title={t(locale, 'experience.pageTitle')} description={t(locale, 'experience.description')}>
  <h1 class="pt-6 pb-2 text-[clamp(36px,6vw,52px)] leading-none font-bold tracking-tight">
    {t(locale, 'experience.title')}
  </h1>

  {
    experience.map((role) => (
      <article class="card mt-7">
        <header class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-xl font-bold">
            {role.title} <span class="text-muted">·</span> {role.company}
          </h2>
          <p class="font-mono text-[13px] text-muted">
            {role.period[locale]}
            {role.location && <> · {role.location[locale]}</>}
          </p>
        </header>
        <ul class="flex list-none flex-col gap-2">
          {role.highlights[locale].map((item) => (
            <li class="relative pl-5 leading-relaxed before:absolute before:top-[0.6em] before:left-0 before:size-2 before:border-2 before:border-ink before:bg-accent">
              {item}
            </li>
          ))}
        </ul>
      </article>
    ))
  }

  <section class="card mt-7" aria-labelledby="education">
    <h2 id="education" class="section-label mb-3.5">{t(locale, 'experience.education')}</h2>
    <ul class="flex flex-col gap-1">
      {
        education.map((e) => (
          <li>
            <span class="font-bold">{e.degree[locale]}</span> · {e.school}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
