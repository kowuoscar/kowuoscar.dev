---
import { existsSync } from 'node:fs';
import { t, type Locale } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Build-time check: the CV button stays disabled until the PDF is dropped into public/cv/.
const cvHref = profile.cv[locale];
const cvAvailable = existsSync(new URL(`../../public${cvHref}`, import.meta.url));

const socials = [
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'GitHub', href: profile.links.github },
  { label: 'Email', href: `mailto:${profile.links.email}` },
];
---

<section class="grid items-center gap-9 py-12 sm:grid-cols-[200px_1fr]">
  <!-- TODO: replace the initials block with a real photo (src/assets + <Image />). -->
  <div
    class="brutal-border brutal-shadow-lg relative grid size-[200px] -rotate-3 place-items-center bg-accent2 text-6xl font-bold text-on-accent2"
  >
    <span aria-hidden="true">{profile.initials}</span>
    <a
      href={profile.links.cka}
      class="brutal-border absolute -right-5 -bottom-4 rotate-[8deg] rounded-full bg-accent px-3.5 py-1.5 font-mono text-sm font-bold text-on-accent no-underline transition-transform hover:rotate-0"
      title={t(locale, 'hero.ckaVerify')}
      aria-label={t(locale, 'hero.ckaVerify')}>CKA ✓</a
    >
  </div>
  <div>
    <h1 class="text-[clamp(40px,7vw,64px)] leading-none font-bold tracking-tight">{profile.name}</h1>
    <p class="mt-3 text-xl font-bold">{profile.role}</p>
    <p class="mt-1.5 font-mono text-sm text-muted">{profile.tagline}</p>
    <p class="mt-1 font-mono text-[13px] text-muted">{profile.stats[locale]}</p>
    <p class="mt-1 font-mono text-[13px] text-muted">📍 {profile.location[locale]}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        cvAvailable ? (
          <a class="btn btn-primary" href={cvHref} download>
            ↓ {t(locale, 'hero.cv')}
          </a>
        ) : (
          <span class="btn btn-primary" aria-disabled="true">
            {t(locale, 'hero.cvSoon')}
          </span>
        )
      }
      {
        socials.map(({ label, href }) => (
          <a class="btn" href={href}>
            {label}
          </a>
        ))
      }
    </div>
  </div>
</section>
