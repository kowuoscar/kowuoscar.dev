---
import { t, type Locale } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="mt-12 flex flex-wrap gap-x-2 font-mono text-[13px] text-muted">
  <span>© {new Date().getFullYear()} kowuoscar.dev</span>
  <span aria-hidden="true">·</span>
  <span>{t(locale, 'footer.built')}</span>
  <span aria-hidden="true">·</span>
  <a href={profile.links.source} class="underline-offset-4 hover:underline">{t(locale, 'footer.source')}</a>
</footer>
